# Copy to .env and adjust for your machine.
# These defaults assume fabric-samples/test-network was bootstrapped at
# FABRIC_SAMPLES_PATH (WSL native filesystem recommended) and the backend is
# run from inside WSL, so it can read the generated crypto material directly.
# All org1/org2 cert & MSP paths below are derived from FABRIC_SAMPLES_PATH
# in src/config.ts -- override individual *_PATH vars only if your layout differs.

PORT=4000

CHANNEL_NAME=mychannel
CHAINCODE_NAME=finclaim

FABRIC_SAMPLES_PATH=/home/habib/finclaim/fabric-samples

ORG1_MSP_ID=Org1MSP
ORG1_PEER_ENDPOINT=localhost:7051
ORG1_PEER_HOST_ALIAS=peer0.org1.example.com

ORG2_MSP_ID=Org2MSP
ORG2_PEER_ENDPOINT=localhost:9051
ORG2_PEER_HOST_ALIAS=peer0.org2.example.com

# AES-256-GCM key for manually encrypting off-chain invoice blobs (prototype only --
# production would use an HSM / KMS, per the whitepaper's stated production roadmap).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INVOICE_ENCRYPTION_KEY=

# Optional: public EVM testnet RPC + private key for the Merkle anchor publisher.
# Leave blank to keep anchors as chaincode-recorded only (no public-chain publish).
PUBLIC_ANCHOR_RPC_URL=
PUBLIC_ANCHOR_PRIVATE_KEY=
